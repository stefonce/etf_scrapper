# Clé requise en header x-api-key pour appeler /medirect-etf-scrape
SCRAPER_API_KEY=change-moi

# Option A : session encodée en base64 (sortie de "npm run encode-session")
MEDIRECT_SESSION_STATE_B64=

# Option B : chemin vers un volume persistant contenant medirect-session.json
# (à utiliser à la place de MEDIRECT_SESSION_STATE_B64 si un volume est monté)
# SESSION_STATE_PATH=/data/medirect-session.json
